{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoin-private-api",
  "account_id": "3b7d7afda6c8bf0aa72256c171dd5f04",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "OWNER_ID": "private-tester",
    "AI_BUDGET_USD": "8.733897",
    "PUBLIC_API_URL": "https://yoin-private-api.h-rion-0910.workers.dev",
    "MEDIA_SERVICE_URL": "https://yoin-audio-300039436163.asia-northeast1.run.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoin",
      "database_id": "ab04f764-9fc9-4cc2-9444-5f54a5a71057",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "yoin-private-audio" }],
  "workflows": [
    {
      "name": "yoin-prepare",
      "binding": "PREPARE",
      "class_name": "PrepareWorkflow"
    },
    {
      "name": "yoin-generate",
      "binding": "GENERATE",
      "class_name": "GenerateWorkflow"
    }
  ],
  "observability": { "enabled": false }
}
