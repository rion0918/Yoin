{
  "expo": {
    "name": "Yoin",
    "slug": "yoin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rion0918.yoin"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.rion0918.yoin"
    },
    "web": {
      "name": "Yoin | 思い出のライブラリ"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "位置情報を使うと選択した録音中の現在地を端末に保存します。",
          "locationAlwaysAndWhenInUsePermission": "位置情報をONにした録音で、未取得の場合に限り最初の位置を得るまで画面ロック中も位置情報を使います。",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "microphonePermission": "思い出に残したい会話を録音するため、マイクを使用します。"
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
