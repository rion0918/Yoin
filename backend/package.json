{
  "name": "yoin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:media": "node --test media/*.test.mjs",
    "check": "../node_modules/.bin/biome check .",
    "format": "../node_modules/.bin/biome format --write .",
    "migrate:local": "wrangler d1 migrations apply yoin --local",
    "dry-run": "wrangler deploy --dry-run --outdir .output"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "4.147.0"
  }
}
