{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "../shared/contracts.ts",
    "../pipeline/google.ts"
  ],
  "exclude": ["node_modules", ".output"]
}
