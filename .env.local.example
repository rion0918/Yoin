# Google AI Studio の有料APIキー。実際の値は .env.local にだけ保存する。
GEMINI_API_KEY=

# アプリ接続先はビルド時に固定する。Play用は eas.json を使用する。
EXPO_PUBLIC_API_URL=https://yoin-private-api.h-rion-0910.workers.dev
EXPO_PUBLIC_FIREBASE_PROJECT_ID=yoin-app-20261004
# Firebase登録後のAndroid非秘密設定。EASでは同名のfile変数を設定する。
GOOGLE_SERVICES_JSON=./google-services.json
# EAS登録後の非秘密プロジェクトID
EAS_PROJECT_ID=
# Play内部テストのversionCode照合用。秘密鍵JSONはリポジトリ外に置く。
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/play-service-account.json
